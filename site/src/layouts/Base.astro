---
import '@fontsource-variable/inter';
import '@fontsource-variable/source-serif-4';
import '@fontsource-variable/source-serif-4/wght-italic.css';
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import '../styles/widgets.css';
import '../styles/flashcards.css';
import '../styles/polish.css';
import Sidebar from '../components/Sidebar.astro';
import SearchDialog from '../components/SearchDialog.astro';
import { BASE, REPO, withBase } from '../lib/site';

interface Props {
  title: string;
  description?: string;
  current?: string; // page path for nav highlighting, e.g. "learn/cache/"
  layout?: 'doc' | 'wide';
  hasToc?: boolean;
}
const { title, description = 'A readable, searchable guide to designing large-scale systems: concepts, trade-offs and worked interview solutions.', current = '', layout = 'doc', hasToc = false } = Astro.props;
const section = current.split('/')[0];
const nav = [
  { label: 'Learn', href: 'learn/', key: 'learn' },
  { label: 'Interview', href: 'interview/', key: 'interview' },
  { label: 'Practice', href: 'practice/', key: 'practice' },
  { label: 'Reference', href: 'reference/', key: 'reference' },
];
const fullTitle = current === '' && layout === 'wide' ? title : `${title} · System Design Primer`;
---
<!doctype html>
<html lang="en" data-base={BASE}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <meta name="theme-color" content="#fbfbf8" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0e1110" media="(prefers-color-scheme: dark)" />
    <link rel="icon" type="image/svg+xml" href={withBase('favicon.svg')} />
    <script is:inline>
      try {
        var t = localStorage.getItem('theme');
        if (!t) t = matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        document.documentElement.dataset.theme = t;
        if (localStorage.getItem('diagrams') === 'original') document.documentElement.dataset.diagrams = 'original';
      } catch (e) {}
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="progress" aria-hidden="true"><i id="progress-bar"></i></div>
    <header class="site-header">
      <div class="inner">
        {layout === 'doc' && (
          <button class="icon-btn menu-btn" id="menu-btn" aria-label="Open navigation" aria-controls="sidebar" type="button">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M4 7h16M4 12h16M4 17h10" /></svg>
          </button>
        )}
        <a class="brand" href={withBase('')} aria-label="System Design Primer home">
          <svg class="brand-mark" viewBox="0 0 32 32" aria-hidden="true">
            <rect width="32" height="32" rx="9" fill="var(--accent)" />
            <g stroke="var(--accent-ink)" stroke-width="1.8" stroke-linecap="round" fill="none"><path d="M16 9v5M16 14 9.5 21M16 14l6.5 7" /></g>
            <g fill="var(--accent-ink)"><circle cx="16" cy="8.5" r="2.6" /><circle cx="9.5" cy="22" r="2.6" /><circle cx="22.5" cy="22" r="2.6" /></g>
          </svg>
          <span>System Design <small>Primer</small></span>
        </a>
        <nav class="top-nav" aria-label="Sections">
          {nav.map((n) => <a href={withBase(n.href)} aria-current={section === n.key ? 'true' : undefined}>{n.label}</a>)}
        </nav>
        <div class="header-spacer"></div>
        <button class="search-btn" id="search-open" aria-label="Search" type="button">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
          <span>Search the primer</span><kbd id="search-kbd">Ctrl K</kbd>
        </button>
        <button class="icon-btn theme-toggle" id="theme-toggle" aria-label="Toggle dark mode" type="button">
          <svg class="sun" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><circle cx="12" cy="12" r="4" /><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" /></svg>
          <svg class="moon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z" /></svg>
        </button>
        <a class="icon-btn" href={REPO} target="_blank" rel="noopener noreferrer" aria-label="View on GitHub">
          <svg viewBox="0 0 16 16" fill="currentColor"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27s1.36.09 2 .27c1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z" /></svg>
        </a>
      </div>
    </header>

    {layout === 'doc' ? (
      <div class:list={['shell', { 'no-toc': !hasToc }]}>
        <Sidebar current={current} />
        <main id="main" class="main"><slot /></main>
        <slot name="toc" />
      </div>
    ) : (
      <main id="main"><slot /></main>
    )}

    <footer class="site-footer">
      <div class="inner">
        <div>
          <p><strong>System Design Primer</strong>: a reading experience for an open-source project.</p>
          <p>Content by <a href="https://github.com/donnemartin" target="_blank" rel="noopener noreferrer">Donne Martin</a> and contributors, licensed under <a href="https://creativecommons.org/licenses/by/4.0/" target="_blank" rel="noopener noreferrer">CC BY 4.0</a>.</p>
        </div>
        <div>
          <p><a href={REPO} target="_blank" rel="noopener noreferrer">Source on GitHub</a> · <a href={`${REPO}/blob/master/CONTRIBUTING.md`} target="_blank" rel="noopener noreferrer">Contribute</a></p>
          <p><a href={withBase('about/')}>About</a></p>
        </div>
      </div>
    </footer>

    <SearchDialog />
    <script>
      import '../scripts/ui.ts';
    </script>
  </body>
</html>
