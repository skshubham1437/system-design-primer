<svg viewBox="0 0 640 400" role="img" aria-label="Diagram of a client request passing through a load balancer to app servers, a cache and a replicated database">
  <defs>
    <marker id="arr" viewBox="0 0 10 10" refX="8" refY="5" markerWidth="6" markerHeight="6" orient="auto-start-reverse"><path d="M0 0 10 5 0 10z" fill="var(--accent)" /></marker>
  </defs>
  <g class="edges" fill="none" stroke="var(--accent)" stroke-width="1.6" marker-end="url(#arr)">
    <path class="flow" d="M106 200H150" />
    <path class="flow" d="M260 200C288 200 290 86 316 86" />
    <path class="flow" d="M260 200H316" />
    <path class="flow" d="M260 200C288 200 290 314 316 314" />
    <path class="flow d2" d="M426 86C458 86 458 96 490 96" />
    <path class="flow d2" d="M426 200C458 200 458 216 490 216" />
    <path class="flow d3" d="M426 314C458 314 458 316 490 316" />
  </g>
  <path d="M550 242V290" stroke="var(--ink-3)" stroke-width="1.4" stroke-dasharray="3 5" fill="none" marker-end="url(#arr)" />
  <g class="node">
    <rect x="10" y="172" width="96" height="56" rx="12" />
    <rect x="150" y="172" width="110" height="56" rx="12" class="hot" />
    <rect x="316" y="60" width="110" height="52" rx="12" />
    <rect x="316" y="174" width="110" height="52" rx="12" />
    <rect x="316" y="288" width="110" height="52" rx="12" />
    <rect x="490" y="70" width="120" height="52" rx="12" />
    <rect x="490" y="190" width="120" height="52" rx="12" />
    <rect x="490" y="290" width="120" height="52" rx="12" />
  </g>
  <g class="label" text-anchor="middle">
    <text x="58" y="196">Client</text><text x="58" y="214" class="sub">browser</text>
    <text x="205" y="196">Load balancer</text><text x="205" y="214" class="sub">L4 / L7</text>
    <text x="371" y="83">App server</text><text x="371" y="100" class="sub">stateless</text>
    <text x="371" y="197">App server</text><text x="371" y="214" class="sub">stateless</text>
    <text x="371" y="311">App server</text><text x="371" y="328" class="sub">stateless</text>
    <text x="550" y="93">Cache</text><text x="550" y="110" class="sub">hot reads</text>
    <text x="550" y="213">Primary DB</text><text x="550" y="230" class="sub">writes</text>
    <text x="550" y="313">Replica</text><text x="550" y="330" class="sub">reads</text>
  </g>
  <text x="560" y="272" class="cap">replication</text>
</svg>
<style>
  .node rect { fill: var(--surface); stroke: var(--line-strong); stroke-width: 1.3; filter: drop-shadow(0 6px 10px rgb(30 28 20 / 0.06)); }
  .node rect.hot { stroke: var(--accent); fill: var(--accent-soft); }
  .label text { font: 600 13.5px var(--font-ui); fill: var(--ink); }
  .label text.sub { font: 500 11px var(--font-mono); fill: var(--ink-3); }
  .cap { font: 500 10.5px var(--font-mono); fill: var(--ink-3); }
  .flow { stroke-dasharray: 5 7; animation: flow 1.4s linear infinite; }
  .flow.d2 { animation-delay: -0.5s; }
  .flow.d3 { animation-delay: -0.9s; }
  @keyframes flow { to { stroke-dashoffset: -24; } }
</style>
