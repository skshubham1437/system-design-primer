---
import { features, groups, dbModules, pagesInGroup, pagesInModule, solutions, oodPages, href, withBase, type Page } from '../lib/site';
interface Props { current: string }
const { current } = Astro.props;
const cur = (p: Page) => (p.path === current ? 'page' : undefined);
const inSolutions = solutions.some((p) => p.path === current);
const inOod = oodPages.some((p) => p.path === current);
---
<nav class="sidebar" aria-label="Primary" id="sidebar">
  <div class="drawer-head">
    <strong>Navigation</strong>
    <button class="icon-btn" id="drawer-close" type="button" aria-label="Close navigation">
      <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6 6 18" /></svg>
    </button>
  </div>
  {features.progressDashboard && (
    <section class="nav-group nav-top">
      <ul><li><a class="nav-link" href={withBase('progress/')} aria-current={current === 'progress/' ? 'page' : undefined}>Your progress</a></li></ul>
    </section>
  )}
  {groups.map((g) => (
    <section class={`nav-group group-${g.id}`}>
      <h2>{g.label}</h2>
      <ul>
        {g.id === 'practice' && (
          <>
            <li><a class="nav-link" href={withBase('practice/')} aria-current={current === 'practice/' ? 'page' : undefined}>Overview</a></li>
            {features.quizzes && <li><a class="nav-link" href={withBase('quiz/')} aria-current={current === 'quiz/' ? 'page' : undefined}>Mixed quiz</a></li>}
            <li>
              <details class="nav-sub" open={inSolutions}>
                <summary>System design <span class="count">· {solutions.length}</span></summary>
                <ul>{solutions.map((p) => <li><a class="nav-link" href={href(p)} data-path={p.path} aria-current={cur(p)}>{p.short ?? p.title}</a></li>)}</ul>
              </details>
            </li>
            <li>
              <details class="nav-sub" open={inOod}>
                <summary>Object-oriented <span class="count">· {oodPages.length}</span></summary>
                <ul>{oodPages.map((p) => <li><a class="nav-link" href={href(p)} data-path={p.path} aria-current={cur(p)}>{p.short ?? p.title.replace(/^Design (the |a |an )?/i, '')}</a></li>)}</ul>
              </details>
            </li>
          </>
        )}
        {g.id === 'databases' && (
          <>
            <li><a class="nav-link" href={withBase('databases/')} aria-current={current === 'databases/' ? 'page' : undefined}>Overview</a></li>
            {dbModules.filter((m) => pagesInModule(m.id).length).map((m) => (
              <li>
                <details class="nav-sub" open={pagesInModule(m.id).some((p) => p.path === current)}>
                  <summary>{m.label} <span class="count">· {pagesInModule(m.id).length}</span></summary>
                  <ul>{pagesInModule(m.id).map((p) => <li><a class="nav-link" href={href(p)} data-path={p.path} aria-current={cur(p)}>{p.title}</a></li>)}</ul>
                </details>
              </li>
            ))}
          </>
        )}
        {g.id !== 'databases' && pagesInGroup(g.id).map((p) => (
          <li><a class="nav-link" href={href(p)} data-path={p.path} aria-current={cur(p)}>{p.title}{p.path === 'practice/flashcards/' && <span class="due-badge" data-due-badge hidden></span>}</a></li>
        ))}
      </ul>
    </section>
  ))}
  <section class="nav-group group-reference">
    <ul><li><a class="nav-link" href={withBase('about/')} aria-current={current === 'about/' ? 'page' : undefined}>About this project</a></li></ul>
  </section>
</nav>
